---
import 'bootstrap/dist/css/bootstrap.min.css';
import 'bootstrap-icons/font/bootstrap-icons.css';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const { title = 'Mobile Car Repair Services', description = 'Professional mobile car body repairs, dent removal, and paint restoration at your location.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="description" content="Professional mobile car body repair services, offering expert respraying, dent removal, and paintwork restoration at your convenience. Fast, reliable, and high-quality service." />
  <meta name="keywords" content="Mobile Car Repair, Car Body Repair, Mobile Dent Removal, Car Respray, Paint Restoration, Mobile Auto Repair, Scratch Repair, Car Paintwork, Automotive Repair Services" />
  <meta name="author" content="Leroy Russell">

  <link rel="icon" type="image/png" sizes="32x32" href={`${base}assets/images/logo/logo.png`}>
  <link rel="apple-touch-icon" sizes="180x180" href={`${base}/assets/images/logo/apple-touch-logo.png`}>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  <Navbar />
  <main id="main">
    <slot />
  </main>
  <Footer />

  <script>
    import 'bootstrap/dist/js/bootstrap.bundle.min.js';
  </script>

</body>
</html>
