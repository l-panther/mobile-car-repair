---
import 'bootstrap/dist/css/bootstrap.min.css';
import 'bootstrap-icons/font/bootstrap-icons.css';
import { asset } from '../utils/paths';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Mobile Car Body Repairs | Scratches, Dents & Paintwork</title>
  <meta name="description" content="Professional mobile car body repairs at your convenience. From scratches and dents to bumper scuffs and paintwork restoration, we help restore your vehicle's appearance." />
  <meta name="author" content="Leroy Russell">

  <link rel="icon" type="image/png" sizes="32x32" href={asset('assets/images/logo/logo.png')}>
  <link rel="apple-touch-icon" sizes="180x180" href={asset('assets/images/logo/apple-touch-logo.png')}>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  <Navbar />
  <main id="main">
    <slot />
  </main>
  <Footer />

  <script>
    import 'bootstrap/dist/js/bootstrap.bundle.min.js';
  </script>

</body>
</html>
