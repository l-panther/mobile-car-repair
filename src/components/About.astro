
---
const highlights = [
  {
    icon: "bi-calendar-check",
    title: "5 Days a Week",
    description: "Flexible appointments at a time that suits you."
  },
  {
    icon: "bi-geo-alt",
    title: "Areas We Cover",
    description: "East London, South London and the whole of Kent."
  },
  {
    icon: "bi-car-front",
    title: "Mobile Repairs",
    description: "Professional repairs at your home or workplace."
  },
  {
    icon: "bi-camera",
    title: "Free Quotes",
    description: "Send us a photo of the damage for an estimate."
  }
];
---

<section class="about-section" id="about">
  <div class="container">

    <div class="about-layout">

      <!-- LEFT: ABOUT CONTENT -->
      <div class="about-content">

        <span class="section-eyebrow">LEARN MORE</span>

        <h2 class="about-title">
          ABOUT <span>US</span>
        </h2>

        <p>
          We specialise in professional car bodywork repairs,
          bringing our mobile repair service directly to your
          home or workplace.
        </p>

        <p>
          From minor scratches and dents to paintwork restoration,
          we provide convenient solutions to help get your vehicle
          looking its best again.
        </p>

        <p>
          Need a repair? Simply send us a photograph of the damage
          and we'll provide an estimate before arranging a
          convenient time to carry out the work.
        </p>

        <a href="#contact" class="about-btn">
          Get a Free Quote
          <i class="bi bi-arrow-right"></i>
        </a>

      </div>

      <!-- RIGHT: HIGHLIGHT CARDS -->
      <div class="about-highlights">

        {highlights.map((item) => (
          <div class="about-highlight-card">

            <div class="highlight-icon">
              <i class={`bi ${item.icon}`} aria-hidden="true"></i>
            </div>

            <div class="highlight-content">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>

          </div>
        ))}

      </div>

    </div>

  </div>
</section>

<style>

/* ==========================================
   ABOUT SECTION
========================================== */

.about-section {
  position: relative;
  background: #080808;
  padding: 100px 0;
}

/* MAIN TWO-COLUMN LAYOUT */

.about-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: 70px;
}

/* ==========================================
   LEFT: CONTENT
========================================== */

.about-content {
  min-width: 0;
}

.section-eyebrow {
  display: inline-block;
  margin-bottom: 12px;
  color: #e02020;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.about-title {
  margin: 0 0 24px;
  color: #fff;
  font-size: clamp(2rem, 3vw, 2.8rem);
  font-weight: 800;
  line-height: 1.1;
  text-transform: uppercase;
}

.about-title span {
  color: #e02020;
}

.about-content p {
  margin: 0 0 18px;
  color: #bcbcbc;
  font-size: 0.95rem;
  line-height: 1.8;
}

.about-content p:last-of-type {
  margin-bottom: 30px;
}

/* ABOUT BUTTON */

.about-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  padding: 14px 24px;

  background: #d71920;
  border: 1px solid #d71920;
  border-radius: 5px;

  color: #fff;
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;

  transition:
    background 0.25s ease,
    border-color 0.25s ease,
    transform 0.25s ease;
}

.about-btn:hover {
  background: #b9151b;
  border-color: #b9151b;
  color: #fff;
  transform: translateY(-2px);
}

.about-btn i {
  font-size: 1rem;
}

/* ==========================================
   RIGHT: HIGHLIGHT GRID
========================================== */

.about-highlights {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  min-width: 0;
}

/* HIGHLIGHT CARD */

.about-highlight-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;

  min-width: 0;
  min-height: 185px;
  padding: 25px 22px;

  background: #141416;
  border: 1px solid #2a2a2e;
  border-radius: 8px;

  transition:
    border-color 0.25s ease,
    background 0.25s ease,
    transform 0.25s ease;
}

.about-highlight-card:hover {
  background: #19191c;
  border-color: rgba(224, 32, 32, 0.55);
  transform: translateY(-3px);
}

/* ICON */

.highlight-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 42px;
  height: 42px;
  margin-bottom: 20px;

  border: 1px solid #d71920;
  border-radius: 50%;

  color: #e02020;
}

.highlight-icon i {
  font-size: 1.15rem;
  line-height: 1;
}

/* CARD TEXT */

.highlight-content h3 {
  margin: 0 0 8px;

  color: #fff;
  font-size: 0.95rem;
  font-weight: 700;
  line-height: 1.3;
}

.highlight-content p {
  margin: 0;

  color: #a9a9a9;
  font-size: 0.82rem;
  line-height: 1.65;
}

/* ==========================================
   TABLET
========================================== */

@media (max-width: 991.98px) {

  .about-section {
    padding: 75px 0;
  }

  .about-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 45px;
  }

  .about-content {
    max-width: 700px;
  }

  .about-highlights {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .about-highlight-card {
    min-height: 160px;
  }

}

/* ==========================================
   MOBILE
========================================== */

@media (max-width: 575.98px) {

  .about-section {
    padding: 60px 0;
  }

  .about-layout {
    gap: 35px;
  }

  .about-title {
    font-size: 2rem;
    margin-bottom: 20px;
  }

  .about-content p {
    font-size: 0.9rem;
    line-height: 1.75;
  }

  .about-btn {
    padding: 12px 20px;
    font-size: 0.8rem;
  }

  .about-highlights {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .about-highlight-card {
    flex-direction: row;
    align-items: center;
    gap: 18px;

    min-height: auto;
    padding: 20px;
  }

  .highlight-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    margin-bottom: 0;
  }

  .highlight-content h3 {
    font-size: 0.9rem;
    margin-bottom: 5px;
  }

  .highlight-content p {
    font-size: 0.8rem;
  }

}

/* ==========================================
   REDUCED MOTION
========================================== */

@media (prefers-reduced-motion: reduce) {
  .about-btn,
  .about-highlight-card {
    transition: none;
  }

  .about-btn:hover,
  .about-highlight-card:hover {
    transform: none;
  }
}

</style>
